rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Collection-group read rule for subtasks.
    // Path-nested rules (inside match /families/{familyId}/...) do NOT apply to
    // collection-group queries, so this top-level wildcard rule is required to
    // allow the collectionGroup('subtasks') listener in the jobs store.
    // Access is gated on the familyId field stamped on every subtask document.
    match /{path=**}/subtasks/{subtaskId} {
      allow read: if resource.data.familyId != null &&
        isFamilyMember(resource.data.familyId);
    }

    // Returns true if the requesting user is logged in AND has a member document
    // inside the given family. Used to gate all read/write access to family data.
    function isFamilyMember(familyId) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid));
    }

    // Returns true if the user is a family member whose role field is "parent".
    // Used to restrict destructive or administrative actions (delete, update family).
    function isParent(familyId) {
      return isFamilyMember(familyId) &&
        get(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)).data.role == 'parent';
    }

    // Each user has a private document that records which family they belong to.
    // Only the owner can read or write their own document — nobody else can touch it.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Invite codes map a code to a familyId.
    // A signed-in user can GET a single code directly (needed to look up the family
    // when joining) but cannot LIST the collection — listing is left to deny so the
    // codes (and the familyIds they map to) cannot be enumerated.
    // Only existing family members can write codes (created by the parent during family setup).
    match /inviteCodes/{code} {
      allow get: if request.auth != null;
      allow write: if request.auth != null &&
        exists(/databases/$(database)/documents/families/$(request.resource.data.familyId)/members/$(request.auth.uid));
    }

    // The family document holds the family name, creation date, and invite code.
    match /families/{familyId} {
      // Any family member can read the family document (e.g. to display the family name).
      allow read: if isFamilyMember(familyId);
      // A signed-in user can create a family only if they stamp themselves as the
      // creator. createdBy is what lets that one user seat themselves as parent below;
      // it cannot be forged for someone else.
      allow create: if request.auth != null &&
        request.resource.data.createdBy == request.auth.uid;
      // Only parents can update the family document (e.g. to change the family name).
      allow update: if isParent(familyId);

      // Each member document stores the person's display name, role, and colour.
      match /members/{uid} {
        // Any family member can read the member list (needed to show avatars and names).
        allow read: if isFamilyMember(familyId);

        // Parents can add, edit, or remove any member in their family.
        allow write: if isParent(familyId);

        // A user may seat THEMSELVES into a family without being a member yet, but only:
        //  - as 'parent' if they are the family's creator (the first-run setup), or
        //  - as 'child' if they present a valid invite code that maps to THIS family.
        // This blocks two attacks the old `uid == request.auth.uid` rule allowed:
        // self-promotion to parent, and joining a stranger's family without its code.
        allow create: if request.auth != null && request.auth.uid == uid && (
          (request.resource.data.role == 'parent'
            && get(/databases/$(database)/documents/families/$(familyId)).data.createdBy == request.auth.uid)
          ||
          (request.resource.data.role == 'child'
            && exists(/databases/$(database)/documents/inviteCodes/$(request.resource.data.inviteCode))
            && get(/databases/$(database)/documents/inviteCodes/$(request.resource.data.inviteCode)).data.familyId == familyId)
        );

        // A user may edit their own member doc (e.g. name/colour) but cannot change their role.
        allow update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.role == resource.data.role;
      }

      // Household jobs — per-family job tracker.
      // Any member can suggest and read jobs. Parents have full control.
      // A child may edit only the title/description of their own still-suggested job.
      match /householdJobs/{jobId} {
        allow read: if isFamilyMember(familyId);
        allow create: if isFamilyMember(familyId)
          && request.resource.data.suggestedBy == request.auth.uid
          && request.resource.data.status == 'suggested'
          && (isParent(familyId)
              || (request.resource.data.priority == null
                  && request.resource.data.assignedTo == null));
        allow delete: if isParent(familyId);
        allow update: if isParent(familyId)
          || (isFamilyMember(familyId)
              && resource.data.suggestedBy == request.auth.uid
              && resource.data.status == 'suggested'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'description', 'updatedAt']));

        // Subtasks live under each job document.
        // Parents have full CRUD. Any member can toggle done (+updatedAt only).
        match /subtasks/{subtaskId} {
          allow read: if isFamilyMember(familyId);
          allow create: if isParent(familyId)
            && request.resource.data.familyId == familyId
            && request.resource.data.jobId == jobId;
          allow delete: if isParent(familyId);
          allow update: if isParent(familyId)
            || (isFamilyMember(familyId)
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['done', 'updatedAt']));
        }
      }

      // Pocket money config and running balance snapshot per child.
      // Parents read and write any child's document.
      // Children can read their own document (to display their balance) but never write —
      // balance updates are only committed when a parent views the screen.
      match /pocketMoney/{childUid} {
        allow read:  if isParent(familyId) ||
                        (isFamilyMember(familyId) && request.auth.uid == childUid);
        allow write: if isParent(familyId);

        // Transaction history subcollection — same access pattern as the parent document.
        match /transactions/{txnId} {
          allow read:  if isParent(familyId) ||
                          (isFamilyMember(familyId) && request.auth.uid == childUid);
          allow write: if isParent(familyId);
        }
      }

      // A shopping list document holds a family's named shopping list.
      // Lists live under the family document, so the family scope comes from the
      // path (familyId) — there is no familyId field on the document to check.
      match /shoppingLists/{listId} {
        // Any family member can read a list. All list-document writes are parent-only —
        // children only ever write to the items subcollection, never the list document.
        allow read: if isFamilyMember(familyId);
        allow create, update, delete: if isParent(familyId);

        // Individual shopping items live in the items subcollection.
        // Children are read-only on items — only parents can add, tick, delete, or toggle priority.
        match /items/{itemId} {
          allow read: if isFamilyMember(familyId);
          // name capped at 80 chars — keep in sync with ITEM_NAME_MAX_LENGTH in src/constants/shopping.js
          allow create, update: if isParent(familyId)
            && request.resource.data.name.size() <= 80;
          allow delete: if isParent(familyId);
        }
      }

      // Wish lists — one flat collection per family; ownerUid names whose list
      // each item belongs to. Every family member can read every list (that is
      // the point of the feature). Writes are gated on ownership, not role:
      // you manage your own list, and parents can also add to and tick any
      // member's list. ownerUid is immutable on update, so an item can never be
      // moved onto someone else's list.
      match /wishListItems/{itemId} {
        // Field length caps — keep in sync with the WISH_ITEM_*_MAX_LENGTH
        // constants in src/constants/wishList.js. note and link are capped as
        // well as name: this is the only collection where a non-parent writes
        // free-form text, and the store subscribes to the whole collection
        // unfiltered, so every family device downloads whatever is written.
        // Optional fields are read with get(..., null) so an absent field
        // passes and only a present, oversized one is rejected.
        function wishItemFieldsValid(data) {
          return data.name is string
            && data.name.size() <= 80
            && (data.get('note', null) == null ||
                (data.get('note', null) is string && data.get('note', null).size() <= 300))
            && (data.get('link', null) == null ||
                (data.get('link', null) is string && data.get('link', null).size() <= 500));
        }

        allow read: if isFamilyMember(familyId);

        allow create: if isFamilyMember(familyId)
          && wishItemFieldsValid(request.resource.data)
          && (request.resource.data.ownerUid == request.auth.uid || isParent(familyId));

        allow update: if isFamilyMember(familyId)
          && request.resource.data.ownerUid == resource.data.ownerUid
          && wishItemFieldsValid(request.resource.data)
          && (resource.data.ownerUid == request.auth.uid || isParent(familyId));

        allow delete: if isFamilyMember(familyId)
          && (resource.data.ownerUid == request.auth.uid || isParent(familyId));
      }

      // Supermarkets — per-family stores, each with its own aisle ordering (#137 Part B).
      // Any member can read (to switch the view and see aisle layout); all writes are
      // parent-only, mirroring shopping-list and aisle management.
      match /supermarkets/{supermarketId} {
        allow read: if isFamilyMember(familyId);
        allow create, update, delete: if isParent(familyId);
      }
    }

  }
}
